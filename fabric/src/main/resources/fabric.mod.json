{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://curseforge.com/minecraft/mc-mods/maphud",
    "sources": "https://github.com/MincraftEinstein/MapHUD",
    "issues": "https://github.com/MincraftEinstein/MapHUD/issues"
  },
  "license": "${license}",
  "icon": "pack.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "einstein.maphud.MapHUDFabric"
    ]
  },
  "mixins": [
    "maphud.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": ">=${minecraft_version} <${max_minecraft_version}",
    "java": ">=${java_version}",
    "fzzy_config": ">=${fzzy_config_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.modrinth": "https://modrinth.com/mod/maphud",
        "modmenu.curseforge": "https://curseforge.com/minecraft/mc-mods/maphud",
        "modmenu.discord": "https://discord.gg/gSsaFAvrBM",
        "modmenu.kofi": "https://ko-fi.com/mincrafteinstein"
      }
    },
    "fzzy_config": [
      "${mod_id}"
    ]
  }
}
